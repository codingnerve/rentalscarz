# ==============================================================================
# RentalsCarz.co — Environment Configuration Template
# ==============================================================================

# Database Connection (Default: local SQLite database for zero-config run)
# For production PostgreSQL (Supabase, Neon, AWS RDS, Railway), set:
# DATABASE_URL="postgresql://user:password@host:5432/rentalscarz?schema=public&sslmode=require"
DATABASE_URL="file:./dev.db"

# Admin Authentication Session Secret (HMAC SHA-256)
# Generate a strong 64-character secret in production using `openssl rand -hex 32`
ADMIN_SESSION_SECRET="rentalscarz-production-admin-secret-key-2026-change-in-production"

# Default Operational Admin Credentials (seeded on initial initialization)
ADMIN_DEFAULT_PASSWORD="AdminPassword2026!"

# Public Base URL
NEXT_PUBLIC_APP_URL="https://rentalscarz.co"

# Google Analytics 4 Measurement ID (format: G-XXXXXXXXXX)
NEXT_PUBLIC_GA_MEASUREMENT_ID="G-RENTALSCARZ"

# Google Ads Conversion Tracking (Optional: AW-XXXXXXXXX)
NEXT_PUBLIC_GOOGLE_ADS_ID="AW-123456789"
NEXT_PUBLIC_GOOGLE_ADS_BOOKING_LABEL="BOOKING_ENQUIRY"

# Email Delivery Provider (Optional: Resend or Brevo)
# If omitted, notifications are safely recorded in the operational audit log
RESEND_API_KEY=""
BREVO_API_KEY=""
EMAIL_FROM="RentalsCarz <reservations@rentalscarz.co>"
SUPPORT_EMAIL="reservations@rentalscarz.co"
